    "homepage": "https://intragile.eu",
    "support": {
        "issues": "https://github.com/intragile/laravel-peppol/issues",
        "source": "https://github.com/intragile/laravel-peppol"
    },
    "authors": [
        {
            "name": "IntrAgile Kft.",
            "email": "info@intragile.eu",
            "homepage": "https://intragile.eu"
        }
    ],
    "require": {
